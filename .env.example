# Copy this file to .env and fill in your real keys. .env is gitignored — never commit real secrets.
# The same variable names are used as GitHub Actions repo secrets for the scheduled workflow.

# Anthropic API key (personal key from https://console.anthropic.com) — used to curate/summarize articles.
ANTHROPIC_API_KEY=

# ElevenLabs API key (from https://elevenlabs.io -> Profile -> API Keys) — used for text-to-speech.
ELEVENLABS_API_KEY=

# Required by NCBI/PubMed E-utilities — any valid email identifying you as the requester.
PUBMED_EMAIL=

# Optional: NCBI API key (free, from your NCBI account) — raises PubMed rate limit from 3 to 10 req/s.
PUBMED_API_KEY=
